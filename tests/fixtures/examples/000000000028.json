{"entries":[{"type":"advanced_custom_function_definition","creationOrder":3249,"expr":"dance(k,u) { /* JS body */ }","hasLargeOps":false,"displayFrame":0,"name":"dance","params":["k","u"],"bodyJs":"  const PI = Math.PI;\n  const b = (u - Math.floor(u)) * 32;                 // beat, 0..32\n  const sec = Math.min(3, Math.floor(b / 8));         // section, 0..3\n  const s = b - 8 * sec;                              // beat within the section, 0..8\n  const f = s - Math.floor(s);                        // phase within the beat, 0..1\n  const ease = v => v <= 0 ? 0 : v >= 1 ? 1 : v * v * (3 - 2 * v);\n  const env = ease(s / 0.75) * ease((8 - s) / 0.75);  // fade in and out at section edges\n  const arc = v => 4 * v * (1 - v);                   // jump arc: 0 at take-off and landing\n  const pos = v => Math.max(0, v);\n  let mTurn = 0, mSway = 0, mHop = 0, mRoll = 0, mSquash = 0, arm1 = 0, arm2 = 0, up = 0, swap = 0;\n  if (sec === 0) {\n    mSway = 0.35 * Math.sin(PI * s / 2) * env;\n    mRoll = -0.1 * Math.sin(PI * s / 2) * env;\n    mTurn += 0.25 * Math.sin(PI * s / 4) * env;\n    mSquash = 0.1 * Math.cos(PI * s) ** 2 * env;\n    arm1 = 1.1 * pos(Math.sin(PI * s)) * env;\n    arm2 = 1.1 * pos(-Math.sin(PI * s)) * env;\n    up = 0.12 * Math.abs(Math.sin(PI * s)) * env;\n    swap = 0.12 * Math.sin(PI * s) * env;\n  } else if (sec === 1) {\n    mHop = 0.45 * arc(f) * env;\n    mTurn += PI / 4 * (Math.floor(s) + ease(f));\n    mSquash = (0.18 * (Math.exp(-((f / 0.1) ** 2)) + Math.exp(-(((1 - f) / 0.1) ** 2))) - 0.1 * arc(f)) * env;\n    arm1 = arm2 = (0.9 + 0.3 * arc(f)) * env;\n  } else if (sec === 2) {\n    mSway = 0.45 * Math.sin(PI * s / 4) * env;\n    mRoll = 0.18 * Math.sin(PI * s) * env;\n    mTurn += 0.5 * Math.sin(PI * s / 2) * env;\n    mSquash = 0.06 * Math.cos(PI * s) ** 2 * env;\n    arm1 = (0.6 + 0.6 * Math.sin(PI * s)) * env;\n    arm2 = (0.6 - 0.6 * Math.sin(PI * s)) * env;\n    up = 0.15 * Math.abs(Math.sin(PI * s)) * env;\n    swap = 0.15 * Math.sin(PI * s) * env;\n  } else if (s < 4) {\n    const fade = ease(s / 0.75);\n    mRoll = 0.1 * Math.sin(4 * PI * s) * fade;\n    mSquash = 0.05 * Math.cos(2 * PI * s) ** 2 * fade;\n    arm1 = (1.2 + 0.3 * Math.sin(2 * PI * s)) * fade;\n    arm2 = (1.2 - 0.3 * Math.sin(2 * PI * s)) * fade;\n  } else if (s < 5) {\n    const v = ease(s - 4);\n    mSquash = 0.05 + 0.17 * v;\n    arm1 = arm2 = 1.2 - 1.6 * v;\n  } else if (s < 7) {\n    const v = (s - 5) / 2;\n    mHop = 0.75 * arc(v);\n    mTurn += 2 * PI * ease(v);\n    mSquash = 0.22 * (1 - ease(v / 0.15)) - 0.1 * Math.sin(PI * v);\n    arm1 = arm2 = -0.4 + 1.7 * ease(v / 0.3);\n  } else {\n    const v = s - 7;\n    mSquash = 0.25 * Math.exp(-((v / 0.15) ** 2)) * (1 - ease(v));\n    arm1 = arm2 = 1.3 * (1 - ease((v - 0.3) / 0.7));\n  }\n  // Leaning pivots about the floor centre; lift the body so the lower feet stay on the floor.\n  mHop += 1.25 * Math.abs(Math.sin(mRoll));\n  let eyes = 1;\n  for (const t of [3, 12.5, 20, 27]) eyes -= 0.95 * Math.exp(-(((b - t) / 0.12) ** 2));\n  return [0, mTurn, mSway, mHop, mRoll, mSquash, arm1, arm2, up, swap, eyes][k];","dependencies":[]},{"type":"variable","creationOrder":3251,"expr":"a=0.07500000000000004","originalExprWithPoints":null,"hasLargeOps":false,"displayFrame":0,"value":0.07500000000000004,"min":0,"max":1,"step":0.000625,"playState":0,"playDirection":1,"playMode":1,"name":"a","key":"a","isEditableIndependent":true,"showOnPlot":false,"cardX":2,"cardY":2,"cardW":220,"cardH":110,"dependencies":[]},{"type":"variable","creationOrder":3252,"expr":"turn=dance(1,a)","originalExprWithPoints":null,"hasLargeOps":false,"displayFrame":0,"value":0.23776412907378833,"processedExpr":"__advanced__.dance(1,a)","name":"turn","key":"turn","isEditableIndependent":false,"dependencies":["a"]},{"type":"variable","creationOrder":3253,"expr":"sway=dance(2,a)","originalExprWithPoints":null,"hasLargeOps":false,"displayFrame":0,"value":-0.20572483830236604,"processedExpr":"__advanced__.dance(2,a)","name"