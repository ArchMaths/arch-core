  "name": "傅里叶变换",
  "version": 11900,
  "calcJSCustomFunctions": {},
  "calcJScalc3": [],
  "customAdvancedFunctions": [
    {
      "name": "forier",
      "params": [
        "x",
        "n",
        "m"
      ],
      "bodyJsString": "\nconst num = Number(x);\nconst time = Number(n);\nconst category = Number(m);\n\nif (isNaN(num) || isNaN(time)) { \n    return NaN;\n}\nlet sum1 = 0;\nif (category === 1){\nlet p1 = 1;\nwhile (p1<=time){\nsum1 += Math.sin((2*p1-1)*num)/(2*p1-1);\np1 += 1;\n}\n} else {\nlet p1 = 1;\nwhile (p1<=time){\nsum1 += Math.sin(p1*num)/p1;\np1 += 1;\n}\n}\n\nreturn sum1;\n"
    },
    {
      "name": "taylor",
      "params": [
        "m",
        "p"
      ],
      "bodyJsString": "const x = Number(m);\nconst a = Number(p);\nlet n = 0;\nlet sum = 0;\nwhile (n<=a){\nlet i=1;\nlet j=1;\nwhile (i<=2*n+1){\nj =j*i;\ni += 1;\n}\nsum += ((-1)**n)*(x**(2*n+1))/j;\nn += 1;\n}\nreturn sum;"
    }
  ],
